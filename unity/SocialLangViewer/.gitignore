# Standard Unity-generated directories/files -- none of this should be committed,
# it's all regenerated locally on first open/build.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

*.apk
*.aab
*.unitypackage
*.app

crashlytics-build.properties

# Auto-generated by Unity on first open -- ProjectSettings/ProjectVersion.txt and
# Packages/manifest.json above are the only hand-authored parts of ProjectSettings/
# and Packages/, everything else Unity creates itself.
/ProjectSettings/*.asset
!/ProjectSettings/ProjectVersion.txt
/Packages/packages-lock.json
